# SakayDavao environment variables — copy to `.env` and fill in as needed.
# All are OPTIONAL: with none set, the app runs fully offline on bundled data.

# Remote route data feed (JSON array of route files, or { "routes": [...] }).
# When unset/unreachable, the app falls back to the bundled seed routes.
# VITE_ROUTES_URL=https://example.com/routes.json

# Optional real-time vehicle feed for live bus positions on the map.
# Expected JSON shape (see src/hooks/useRealtime.js):
#   [{ "routeNumber": "R102", "latitude": 7.07, "longitude": 125.61,
#      "bearing": 90, "nextStopIndex": 4 }, ...]
# When unset/unreachable, the map shows schedule-based SIMULATED buses instead.
# VITE_REALTIME_URL=https://example.com/realtime/vehicles.json

# Contributions API endpoint (API Gateway -> Lambda -> S3; deploy with aws/template.yaml,
# the SAM stack output "ApiUrl" is this value). When unset, contributions stay
# in localStorage only — no network calls are made.
# VITE_CONTRIBUTIONS_API_URL=https://xxxx.execute-api.ap-southeast-1.amazonaws.com/contributions
