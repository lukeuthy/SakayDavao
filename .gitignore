# Dependencies (client/ has its own; matched anywhere by the unanchored entry)
node_modules

# Local env files — NEVER commit real secrets. Real values go in client/.env
# (client build-time) or are passed to SAM/Amplify directly. See server/README.md.
.env
.env.local
.env.*.local

# Client build output (generated by `pnpm build` / Docker / CI — not committed)
/client/dist/
/client/dev-dist/

# Client e2e artifacts
/client/test-results/
/client/playwright-report/
/client/playwright/.cache/

# SAM build artifacts (generated by `sam build` in server/)
/server/.aws-sam/

# OS / editor cruft
.DS_Store
