# ============================================================================
#  SakayDavao — CLIENT environment (client/.env). Copy this file to client/.env.
#
#  EVERY var here is a Vite build-time var: Vite INLINES VITE_* into the public
#  JavaScript bundle at build time. So:
#    - These are PUBLIC. Never put a secret, password, or AWS key here.
#    - Changing one requires a REBUILD (and, on Amplify, a redeploy).
#    - For the hosted site, set these in the Amplify console, not in a file.
#
#  Server-side config does NOT live here. The Lambda's bucket name and the CORS
#  AllowedOrigin live in the SAM stack (server/template.yaml). See the matrix in
#  server/README.md for the full "which key lives where" picture.
#
#  All vars are OPTIONAL — with none set, the app runs fully offline on bundled
#  data (no network calls).
# ============================================================================

# --- Contributions backend -------------------------------------------------
# The HTTPS endpoint of the contributions API. This is the `ApiUrl` OUTPUT printed
# by `sam deploy` in server/. When unset, contributions stay in localStorage only.
# VITE_CONTRIBUTIONS_API_URL=https://xxxx.execute-api.ap-southeast-1.amazonaws.com/contributions

# --- Optional remote route feed --------------------------------------------
# A routes JSON feed you control (array of route files, or { "routes": [...] }).
# OPT-IN: when unset, the app uses bundled seed routes and makes NO route fetch.
# (We intentionally do not ship a default third-party URL.)
# VITE_ROUTES_URL=https://example.com/routes.json

# --- Optional real-time vehicle feed ---------------------------------------
# Live bus positions for the map. Shape (see src/hooks/useRealtime.js):
#   [{ "routeNumber": "R102", "latitude": 7.07, "longitude": 125.61,
#      "bearing": 90, "nextStopIndex": 4 }, ...]
# When unset/unreachable, the map shows schedule-based SIMULATED buses.
# VITE_REALTIME_URL=https://example.com/realtime/vehicles.json

# --- Dev only: tunnel host(s) ----------------------------------------------
# Comma-separated extra hostnames the Vite dev server will accept (e.g. an ngrok
# tunnel for phone testing). Dev server only; has no effect on the production build.
# VITE_DEV_ALLOWED_HOSTS=your-tunnel.ngrok-free.dev
