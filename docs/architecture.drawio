          <mxGeometry x="640" y="600" width="78" height="78" as="geometry" />
        </mxCell>

        <!-- ============ OPTIONAL EXTERNAL FEEDS ============ -->
        <mxCell id="feeds" value="Optional external feeds&#10;VITE_ROUTES_URL · VITE_REALTIME_URL&#10;(unset → bundled/simulated)" style="rounded=1;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="360" y="470" width="180" height="70" as="geometry" />
