        </mxCell>

        <!-- IAM -->
        <mxCell id="iam" value="IAM Roles&#10;least-privilege per Lambda" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.identity_and_access_management_iam;" vertex="1" parent="awsCloud">
          <mxGeometry x="330" y="600" width="78" height="78" as="geometry" />
